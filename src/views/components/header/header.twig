{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
{% set show_announcement = theme.settings.get('enable_announcement_bar', true) %}
{% set announcement_text = theme.settings.get('announcement_text', '✨ شحن مجاني للطلبات أكثر من 300 ريال | استخدمي كود LADY10 لخصم 10% 🌸') %}

<header data-testid="store-header" class="store-header lady-header">
  {# Announcement Bar #}
  {% if show_announcement and announcement_text %}
    <div class="lady-announcement-bar bg-primary text-primary-reverse py-2 px-4 text-center text-xs sm:text-sm font-medium tracking-wide shadow-sm overflow-hidden relative">
      <div class="container flex items-center justify-center gap-2 animate-pulse-soft">
        <span class="inline-block">{{ announcement_text }}</span>
      </div>
    </div>
  {% endif %}

  {# Top Nav #}
  <div class="top-navbar bg-[color:var(--lady-surface,#FCFAF8)] border-b border-[color:var(--lady-border,#F0EAE3)] text-xs">
    <div class="container flex justify-between items-center py-1.5">
      <div class="flex-1 flex items-center gap-3">
          {# Footer Menu / Important links #}
          {% if important_links %}
            <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
          {% endif %}

          {# Language & Currency Component #}
          <div class="header-buttons">
              {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                  <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
              {% endif %}
          </div>

          {# Scopes | Branches #}
          {% if store.scope %}
              <button class="btn--rounded-gray text-xs py-1 px-2.5 rounded-full hover:bg-primary/10 transition-colors"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location rtl:ml-1 ltr:mr-1 text-primary"></i> {{ store.scope.name }}
              </button>
          {% endif %}

          {# Search bar #}
          <div class="header-search flex-1 max-w-xs hidden md:block">
            <salla-search data-testid="store-header-search" inline oval height="34"></salla-search>
          </div>
      </div>

      <div class="flex items-center gap-3">
        <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
      </div>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container backdrop-blur-md bg-white/95 sticky top-0 z-40 transition-all duration-300 border-b border-gray-100 shadow-sm flex items-center">
      <div class="inner bg-inherit w-full py-2 sm:py-3">
          <div class="container">
              <div class="flex items-center justify-between relative">
                  <div class="flex items-center gap-4 lg:gap-8">
                      <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none rtl:ml-2 ltr:mr-2 p-1.5 rounded-full hover:bg-gray-100 transition-colors" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                      </a>
                      <a data-testid="store-header-logo" class="navbar-brand transition-transform hover:scale-[1.02] duration-300" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" class="max-h-12 w-auto object-contain" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                      <div class="hidden lg:block">
                        <custom-main-menu></custom-main-menu>
                      </div>
                  </div>

                  {# Mobile Search Trigger & User Icons #}
                  <div class="flex items-center justify-end gap-2 sm:gap-3">
                      <div class="md:hidden">
                        <salla-search data-testid="store-header-search-mobile" height="34"></salla-search>
                      </div>

                      <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
                      
                      <salla-cart-summary data-testid="store-header-cart" class="rtl:mr-1 ltr:ml-1">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag text-primary hover:scale-110 transition-transform"></i>
                      </salla-cart-summary>
                  </div>
              </div>
          </div>
      </div>
  </div>
</header>
