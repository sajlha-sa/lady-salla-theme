{#
| Variable      | Type   | Description                                                      |
|---------------|--------|------------------------------------------------------------------|
| items[]       | array  | List of 3 features                                               |
| items[].icon  | string | SallaIcons css class `sicon-*`                                   |
| items[].title | string | Title of the feature                                             |
| items[].text  | string | Subtitle for the feature                                         |
| position      | Int    | Sorting number start from zero                                   |
#}
<section data-testid="store-home-features" class="s-block s-block--features container">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {% for item in items %}
          <div class="s-block--features__item group">
            <div class="feature-icon group-hover:scale-110 transition-transform">
              <i class="{{ item.icon }}"></i>
            </div>
            <h2 class="text-sm sm:text-base font-bold text-gray-800 mb-1 group-hover:text-primary transition-colors">{{ item.title }}</h2>
            <p class="text-xs text-gray-500 leading-relaxed">{{ item.text }}</p>
          </div>
      {% endfor %}
    </div>
</section>