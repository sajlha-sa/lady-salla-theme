{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
    <script>
        // Palette Switcher
        function setLadyPalette(palette) {
            const root = document.documentElement;
            if (palette === 'gold') {
                root.style.setProperty('--color-primary', '#1C1917');
                root.style.setProperty('--color-primary-dark', '#000000');
                root.style.setProperty('--color-primary-light', '#F5F3EF');
                root.style.setProperty('--lady-accent', '#C5A880');
                root.style.setProperty('--lady-surface', '#FAF8F5');
                root.style.setProperty('--lady-border', '#EBE5DC');
            } else if (palette === 'mocha') {
                root.style.setProperty('--color-primary', '#A37B5C');
                root.style.setProperty('--color-primary-dark', '#845E42');
                root.style.setProperty('--color-primary-light', '#FAF7F2');
                root.style.setProperty('--lady-accent', '#D4B89B');
                root.style.setProperty('--lady-surface', '#FAF7F2');
                root.style.setProperty('--lady-border', '#EFE7DE');
            } else if (palette === 'lavender') {
                root.style.setProperty('--color-primary', '#93739B');
                root.style.setProperty('--color-primary-dark', '#74547C');
                root.style.setProperty('--color-primary-light', '#F7F4F9');
                root.style.setProperty('--lady-accent', '#BFA4C6');
                root.style.setProperty('--lady-surface', '#FBF9FC');
                root.style.setProperty('--lady-border', '#F0E8F3');
            } else {
                // Rose & Blush (Default)
                root.style.setProperty('--color-primary', '#C4737F');
                root.style.setProperty('--color-primary-dark', '#A3535F');
                root.style.setProperty('--color-primary-light', '#FAF7F2');
                root.style.setProperty('--lady-accent', '#E2A9B2');
                root.style.setProperty('--lady-surface', '#FCFAF8');
                root.style.setProperty('--lady-border', '#F0EAE3');
            }
        }

        // Fit Calculator
        function calculateFit() {
            const height = parseInt(document.getElementById('fit-height').value) || 160;
            const style = document.getElementById('fit-style').value;
            let size = 52;
            if (height >= 170) size = 58;
            else if (height >= 165) size = 56;
            else if (height >= 158) size = 54;
            else if (height >= 152) size = 52;
            else size = 50;

            if (style === 'heels' && height < 170) {
                size += 2;
            }
            document.getElementById('fit-result').innerText = size;
        }

        // Before After Interactive Drag
        document.addEventListener('DOMContentLoaded', () => {
            const slider = document.getElementById('ba-slider-1');
            const overlay = document.getElementById('ba-overlay-1');
            const handle = document.getElementById('ba-handle-1');
            if (slider && overlay && handle) {
                const moveSlider = (e) => {
                    const rect = slider.getBoundingClientRect();
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    let pos = ((clientX - rect.left) / rect.width) * 100;
                    pos = Math.max(5, Math.min(95, pos));
                    overlay.style.width = pos + '%';
                    handle.style.left = pos + '%';
                };

                let isDown = false;
                slider.addEventListener('mousedown', () => isDown = true);
                window.addEventListener('mouseup', () => isDown = false);
                slider.addEventListener('mousemove', (e) => { if (isDown) moveSlider(e); });
                slider.addEventListener('touchmove', moveSlider);
            }
        });
    </script>
{% endblock %}