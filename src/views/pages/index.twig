{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}

{% block content %}
    {# Render Merchant Customizer Components if set in Salla #}
    {% component home %}

    {# 🌟 Complete Interactive Showcase of all Lady Luxury Components 🌟 #}
    <div id="lady-complete-showcase" class="lady-showcase-flow">
        
        {# 1. Hero Promotional Showcase (واجهة ترويجية) #}
        {% include 'components.home.lady-hero-promo' with {
            position: 1,
            component: {
                title: 'هدية لكل مناسبة... لمسة تجعلها لا تُنسى',
                description: 'اكتشفي هدايا وتصاميم مختارة بعناية، مع تغليف فاخر وتخصيص يجعل كل مناسبة أكثر تميزاً وسحراً.',
